# frozen_string_literal: true

# The JSON profile's comparator pin: the GATE ratio is calibrated
# against the json 2.9-line parse baseline (the runners' default gem
# before the main Gemfile pinned the fpconv line for the parity
# specs). json >= 2.10 parses ~20% faster and would silently tighten
# the gate's budget — the referee judges the ENGINE against the
# oracle it was calibrated with, per version.
source "https://rubygems.org"

gemspec path: ".."

gem "json", "2.9.1"
gem "benchmark"
